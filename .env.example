# Copy to .env at the repo root: cp .env.example .env
# Vite (apps/web) and docker compose read this file. The test variables at the
# bottom are read from the shell environment (export them or prefix the command).
# Never commit .env. Every value below is a public/local default, not a secret.

# ---------------------------------------------------------------------------
# Web app (Vite inlines VITE_* into the bundle at build time: never put a
# secret in a VITE_ variable). On Netlify, set these in Site configuration.
# ---------------------------------------------------------------------------

# Data backend: "supabase" or "mock" (in-browser, localStorage, no keys).
# Leave empty to use supabase when URL + key are set, otherwise mock.
VITE_BACKEND=

# Supabase project URL. Hosted: Dashboard > Project Settings > API > Project URL.
# Local (docker compose or `npx supabase start`): http://localhost:54321
VITE_SUPABASE_URL=http://localhost:54321

# Supabase anon (or publishable) key. Public by design: RLS protects the data.
# The default is the well-known local development key for JWT_SECRET below.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Shared demo account used by the "Try the demo" button. Must match supabase/seed.sql.
VITE_DEMO_EMAIL=demo@codesnip.dev
VITE_DEMO_PASSWORD=codesnip-demo

# Mock backend only: artificial latency per call (ms). Set to 4000 to see the
# "waking up the server" banner.
VITE_MOCK_LATENCY_MS=150

# ---------------------------------------------------------------------------
# Local Supabase stack (docker-compose.yml). DEVELOPMENT VALUES ONLY.
# ---------------------------------------------------------------------------

# Password for the postgres, authenticator and supabase_auth_admin roles.
POSTGRES_PASSWORD=postgres
# Signs and verifies JWTs (GoTrue + PostgREST). 32+ characters.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# anon key signed with JWT_SECRET, baked into the web container.
# Regenerate after changing JWT_SECRET: node scripts/generate-keys.mjs "$JWT_SECRET"
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Public URL of the API gateway as the browser sees it.
API_EXTERNAL_URL=http://localhost:54321
# Where auth emails and OAuth redirects send users back to.
SITE_URL=http://localhost:3000
# Other allowed redirect URLs (comma separated, globs allowed).
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://localhost:5173/**,http://localhost:4173/**
# Host ports.
API_PORT=54321
DB_PORT=54322
WEB_PORT=3000
# Run supabase/seed.sql after migrations (true/false).
SEED=true

# GitHub OAuth for the local stack (optional). Create an OAuth app at
# https://github.com/settings/developers with callback URL
# http://localhost:54321/auth/v1/callback
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Tests and tooling
# ---------------------------------------------------------------------------

# Postgres used by `npm run test:db` (RLS tests). Local stack default:
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
# Playwright: "mock" (default) or "supabase" (needs the local stack running).
E2E_BACKEND=mock
# Run e2e against an existing deployment instead of building one, e.g. a Netlify preview.
E2E_BASE_URL=
# Use a preinstalled Chromium instead of `npx playwright install chromium`.
PLAYWRIGHT_CHROMIUM_PATH=

# ---------------------------------------------------------------------------
# GitHub Actions secret (Settings > Secrets > Actions), not a .env value:
#   SUPABASE_DB_URL  Postgres connection string of the hosted project; lets
#                    .github/workflows/reset-demo.yml re-run seed.sql nightly.
# ---------------------------------------------------------------------------
